# Скопируйте файл в .env и укажите настройки своей локальной PostgreSQL.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=your_local_user
DB_PASSWORD='replace_with_your_local_password'
DB_NAME=knowledge_management_local

# Генрация SECRET_KEY (вставлять в терминал):
# python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY='пример'
TOKEN_LIFETIME_MINUTES=15
TOKEN_ALGORITHM=HS256