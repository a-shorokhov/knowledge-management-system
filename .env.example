# Скопируйте файл в .env и укажите настройки своей локальной PostgreSQL.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=your_local_user
DB_PASSWORD='replace_with_your_local_password'
DB_NAME=knowledge_management_local

# Docker Compose использует DB_HOST=db и DB_PORT=5432 внутри контейнера.
# Порт API на Mac; если занят, выберите другой, например 8001.
API_PORT=8000

# Генрация SECRET_KEY (вставлять в терминал):
# python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY='replace_with_a_random_secret_of_at_least_32_characters'
TOKEN_LIFETIME_MINUTES=15
TOKEN_ALGORITHM=HS256

# Yandex Object Storage
S3_ENDPOINT=https://storage.yandexcloud.net
S3_ACCESS_KEY='your_access_key'
S3_SECRET_KEY='your_secret_key'
S3_BUCKET=knowledge-management-system-storage
S3_REGION=ru-central1

# Разрешённые origins фронтенда — JSON-массив; по умолчанию доступ не разрешён.
# Пример локальной настройки: CORS_ORIGINS='["http://localhost:3000"]'
CORS_ORIGINS=[]

# Локальный POSIX-каталог журнала; по умолчанию ~/.local/state/kms/file-cleanup.
# Для запуска без Docker можно задать абсолютный путь вне репозитория.
# FILE_CLEANUP_DIR=/absolute/path/to/kms-file-cleanup
# Compose использует постоянный том в /var/lib/kms/file-cleanup.
